{
  "profile": "bottlenecks-nl/v1",
  "adopts": "wellmanifest/nl-dsl-llm intent_lexicon (Layer 1 deterministic PL/EN fast path)",
  "notes": "Stems are matched as word prefixes after ASCII folding (ą->a, ł->l, ...). A trailing '$' means exact word; a stem containing a space is matched as a phrase.",
  "negation": ["nie$", "not$", "bez$", "don't", "dont$", "never$", "nigdy$", "without$", "odrzuc", "zadnych$"],
  "generic": ["wask", "gardl", "bottleneck", "hotspot", "wolne", "wolny", "wolno", "slow", "spowalnia", "wydajn", "performance", "perf$", "problem", "analiz", "analy", "scan", "skan", "sprawdz", "check", "znajdz", "find", "pokaz", "show", "wykryj", "detect"],
  "intents": [
    {"action": "history.diff", "priority": 10,
     "stems": {"pl": ["porown", "regres", "roznic", "zmian", "pogorsz", "nowe wask"], "en": ["compare", "diff$", "regression", "regress", "changed", "worse", "new bottleneck"]},
     "examples": {"pl": ["porównaj z poprzednim skanem", "pokaż regresje"], "en": ["compare with the previous run", "show regressions"]}},
    {"action": "history.trend", "priority": 9,
     "stems": {"pl": ["trend", "tendencj"], "en": ["trend", "over time"]},
     "examples": {"pl": ["pokaż trend wąskich gardeł"], "en": ["show bottleneck trend"]}},
    {"action": "plan.run_due", "priority": 9,
     "stems": {"pl": ["wykonaj zaplanowane", "uruchom zaplanowane", "zaleg", "naleznosci"], "en": ["run due", "due plans", "execute scheduled", "run scheduled"]},
     "examples": {"pl": ["wykonaj zaplanowane skany"], "en": ["run due plans"]}},
    {"action": "plan.list", "priority": 8,
     "stems": {"pl": ["plany", "harmonogram", "zaplanowane"], "en": ["plans$", "scheduled", "schedules"]},
     "examples": {"pl": ["pokaż plany"], "en": ["list scheduled scans"]}},
    {"action": "history.list", "priority": 8,
     "stems": {"pl": ["histori", "poprzedn", "przebieg", "uruchomien"], "en": ["history", "previous", "runs$", "past$"]},
     "examples": {"pl": ["pokaż historię skanów"], "en": ["show history"]}},
    {"action": "registry.list", "priority": 7,
     "stems": {"pl": ["pomoc", "potrafisz", "mozliwosci", "akcje", "komendy"], "en": ["help$", "capabilit", "actions$", "commands$"]},
     "examples": {"pl": ["co potrafisz?"], "en": ["help"]}},
    {"action": "pipeline.urtlog", "priority": 6,
     "stems": {"pl": ["urtlog", "zdarzen", "wykonan", "logow"], "en": ["urtlog", "events$", "executions", "event log"]},
     "examples": {"pl": ["znajdź wąskie gardła w zdarzeniach urtlog ./state"], "en": ["find bottlenecks in urtlog events ./state"]}},
    {"action": "pipeline.analyze", "priority": 5,
     "stems": {"pl": ["potok", "pipelin", "dag$", "sciezk", "etap", "kolejk", "zadan", "workflow"], "en": ["pipeline", "dag$", "critical path", "stage", "queue", "tasks$", "workflow"]},
     "examples": {"pl": ["pokaż ścieżkę krytyczną pipeline.json"], "en": ["critical path of pipeline.json"]}},
    {"action": "runtime.profile", "priority": 5,
     "stems": {"pl": ["profil", "sprofil", "czas dzialania", "runtime", "wykonanie skryptu"], "en": ["profile", "profiling", "runtime", "hot function"]},
     "examples": {"pl": ["sprofiluj skrypt app.py"], "en": ["profile script app.py"]}},
    {"action": "system.sample", "priority": 4,
     "stems": {"pl": ["system", "host", "serwer", "maszyn", "komputer", "cpu$", "procesor", "ram$", "pamie", "dysk", "swap", "obciaz", "zasob"], "en": ["system", "host$", "server", "machine", "cpu$", "processor", "ram$", "memory", "disk", "swap", "load$", "resource"]},
     "examples": {"pl": ["sprawdź wąskie gardła systemu", "czy brakuje pamięci?"], "en": ["check system bottlenecks", "is the host overloaded?"]}},
    {"action": "code.scan", "priority": 3,
     "stems": {"pl": ["kod", "zrodl", "plik", "funkcj", "petl", "zlozon", "repozytor", "projekt", "statyczn"], "en": ["code", "source", "file", "function", "loop", "complexity", "repo", "project", "static"]},
     "examples": {"pl": ["znajdź wąskie gardła w kodzie src", "pokaż krytyczne problemy w kodzie"], "en": ["find bottlenecks in code src", "top 5 code hotspots"]}},
    {"action": "scan.all", "priority": 1,
     "stems": {"pl": ["wszystk", "calosc", "pelny", "pelna", "wszedzie"], "en": ["everything", "all$", "full$", "everywhere"]},
     "examples": {"pl": ["przeskanuj wszystko"], "en": ["scan everything"]}}
  ],
  "severity": {
    "critical": ["krytycz", "critical"],
    "high": ["wysok", "powazn", "istotn", "high$", "severe", "major"],
    "medium": ["sredn", "medium"],
    "low": ["nisk", "drobn", "low$", "minor"]
  },
  "schedule": ["zaplanuj", "cyklicz", "regularn", "schedule", "periodic", "co$", "every$"],
  "units": {
    "s": ["s$", "sek", "sec"],
    "m": ["m$", "min"],
    "h": ["h$", "godz", "hour"],
    "d": ["d$", "dzien", "dni$", "day"]
  }
}
